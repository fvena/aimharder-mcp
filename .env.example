# Inject these into the server process environment. This file is not loaded automatically.
AIMHARDER_USERNAME=
AIMHARDER_PASSWORD=

# Required when the account belongs to several gyms. Use a gym ID from get_account_context.
# AIMHARDER_DEFAULT_GYM=sample-gym

# Confirmed IANA time zone per gym. Required for bookings and saving results.
# AIMHARDER_GYM_TIME_ZONES={"sample-gym":"Europe/Madrid"}

# Optional gym rules: booking opens N days before class; cancelling within M minutes may lose a credit.
# Values: whole days 1–60; whole minutes 1–10080.
# AIMHARDER_BOOKING_WINDOW_DAYS={"sample-gym":7}
# AIMHARDER_CANCELLATION_WINDOW_MINUTES={"sample-gym":90}

# Ask for confirmation before creating a booking. Cancellations and saving
# or deleting results always require confirmation.
# Values: true (default) | false
# AIMHARDER_REQUIRE_BOOKING_CONFIRMATION=true

# Default participants shown for a class.
# Values: all (default, everyone booked) | following (only athletes you follow in AimHarder)
# AIMHARDER_PARTICIPANTS_FILTER=following

# Friends you cannot follow (private profile): AimHarder user ID to a label. The following filter includes them.
# Find a user ID by listing a class's participants with filter all.
# AIMHARDER_FRIENDS={"123456":"Laura"}

# Workout class shown when you ask for "today's workout" without naming one (exact feed name).
# AIMHARDER_WORKOUT_CLASS={"sample-gym":"CROSS"}

# Weekly booking plan: the class you usually book each weekday, used by prepare_planned_bookings.
# Weekday keys: mon | tue | wed | thu | fri | sat | sun. startTime is HH:mm (24-hour).
# AIMHARDER_BOOKING_PLAN={"sample-gym":{"mon":{"className":"CROSS","startTime":"07:00"},"wed":{"className":"FUNCIONAL","startTime":"19:00"}}}

# Remote use from Claude or ChatGPT (web, desktop and mobile). See docs/remote.md.
# Values: stdio (default, local) | http (remote)
# MCP_TRANSPORT=http
# Public HTTPS origin of this server, without a path. The MCP endpoint is <origin>/mcp.
# MCP_PUBLIC_URL=https://your-app.example.com
# Secret you type to approve a connection (16+ characters). Changing it disconnects every client.
# MCP_OWNER_SECRET=
# Listening address and port (defaults 127.0.0.1 and 3000; the Docker image uses 0.0.0.0 and 8080).
# MCP_HTTP_HOST=0.0.0.0
# PORT=8080
# Extra OAuth redirect URIs, comma-separated, besides Claude, ChatGPT and loopback ones.
# MCP_OAUTH_REDIRECT_URIS=
